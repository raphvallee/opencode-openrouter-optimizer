{
  "name": "opencode-openrouter-optimizer",
  "version": "0.3.0",
  "description": "OpenCode plugin that ranks OpenRouter providers by cost and injects a per-request provider blacklist to keep routes cheap.",
  "keywords": [
    "ai",
    "cost-optimization",
    "llm",
    "oc",
    "oc-plugin",
    "opencode",
    "opencode-plugin",
    "openrouter",
    "pricing",
    "provider-routing",
    "routing"
  ],
  "homepage": "https://github.com/raphvallee/opencode-openrouter-optimizer#readme",
  "bugs": {
    "url": "https://github.com/raphvallee/opencode-openrouter-optimizer/issues"
  },
  "license": "MIT",
  "author": {
    "name": "rafaelodos",
    "url": "https://github.com/raphvallee"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphvallee/opencode-openrouter-optimizer.git"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./gui-experimental": {
      "import": "./dist/gui-experimental.cjs",
      "default": "./dist/gui-experimental.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky && bun run build",
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.build.json",
    "verify": "bun run fmt:check && bun run lint && bun run typecheck && bun test",
    "prepack": "bun run clean && bun run build",
    "prepublishOnly": "bun run verify",
    "pack:dry": "npm pack --dry-run",
    "inspect": "bun run scripts/inspect.ts",
    "selfcheck": "bun run scripts/selfcheck.ts",
    "debug:test": "bun --inspect-wait=6496 run test",
    "debug:inspect": "bun --inspect-wait=6496 run inspect",
    "debug:selfcheck": "bun --inspect-wait=6496 run selfcheck"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "devDependencies": {
    "@opentui/core": "^0.8.0",
    "@opentui/solid": "^0.8.0",
    "@types/bun": "^1.4.4",
    "bun-types": "^1.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "solid-js": "^1.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
