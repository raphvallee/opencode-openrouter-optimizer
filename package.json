{
  "name": "opencode-openrouter-optimizer",
  "version": "0.1.0",
  "description": "OpenCode plugin that ranks OpenRouter providers by cost and injects a per-request provider blacklist to keep routes cheap.",
  "type": "module",
  "license": "MIT",
  "main": "./index.ts",
  "module": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tui": "./src/tui.ts"
  },
  "files": ["index.ts", "src", "scripts", "README.md", "LICENSE"],
  "keywords": ["opencode", "opencode-plugin", "openrouter", "cost-optimization", "routing", "llm"],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "inspect": "bun run scripts/inspect.ts",
    "selfcheck": "bun run scripts/selfcheck.ts",
    "debug:test": "bun --inspect-wait=6496 run test",
    "debug:inspect": "bun --inspect-wait=6496 run inspect",
    "debug:selfcheck": "bun --inspect-wait=6496 run selfcheck"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "^0.8.0",
    "@opentui/solid": "^0.8.0",
    "@types/bun": "^1.4.4",
    "bun-types": "^1.4.4",
    "solid-js": "^1.9.0",
    "typescript": "^7.0.2"
  }
}
